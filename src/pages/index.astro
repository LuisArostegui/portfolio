---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCase from '../components/ProjectCase.astro';
import { getCvLabel } from '../lib/cv';
import { getExperienceDocuments } from '../lib/content/experience';
import type { ProjectDetail } from '../lib/content/models';
import { getFeaturedProjects, getProjectById } from '../lib/content/projects';
import { siteMetadata } from '../lib/siteMetadata';
import { cvAction } from '../lib/siteNavigation';

const cvLabel = getCvLabel();
const experience = await getExperienceDocuments();
const featuredProjects = await getFeaturedProjects(3);
const cases = (
  await Promise.all(
    featuredProjects.map(async ({ id }) => (await getProjectById(id))?.data),
  )
).filter((project): project is ProjectDetail => project !== undefined);

const [githubUrl, linkedInUrl] = siteMetadata.owner.profileUrls;
const contactEmail = 'luisarosteguiruizit@gmail.com';

function getYear(period: string) {
  return period.slice(0, 4);
}
---

<BaseLayout
  title="Luis Arostegui Ruiz | Software Engineer"
  description="Frontend-focused software engineer building customer banking journeys in React and TypeScript at Openbank."
  pathname="/"
>
  <div class="frame">
    <div class="trace" aria-hidden="true" data-trace></div>

    <section id="top" class="hero" aria-labelledby="hero-name">
      <span class="node" aria-hidden="true" data-node></span>
      <p class="hero__status">
        <span class="hero__lamp" aria-hidden="true"></span>
        Software Engineer at Openbank
      </p>
      <h1 id="hero-name" class="hero-name">
        <span>Luis</span>
        <span>Arostegui</span>
        <span>Ruiz</span>
      </h1>
      <p class="hero__lede">
        Frontend-focused software engineer. I build customer banking journeys in
        React and TypeScript, from KYC to deposits.
      </p>
      <div class="actions">
        <a class="button button--primary" href="#experience">
          See my experience
        </a>
        <a class="button" href={cvAction.href} download>
          Download {cvLabel}
        </a>
      </div>
      <dl class="hero__facts">
        <div class="hero__fact">
          <dt>since 2024</dt>
          <dd>Openbank, Santander group</dd>
        </div>
        <div class="hero__fact">
          <dt>daily stack</dt>
          <dd>React, TypeScript, Jest</dd>
        </div>
        <div class="hero__fact">
          <dt>2022–2024</dt>
          <dd>Nucleoo, consultancy</dd>
        </div>
      </dl>
    </section>

    <section
      id="experience"
      class="section"
      aria-labelledby="experience-heading"
    >
      <span class="node" aria-hidden="true" data-node></span>
      <h2 id="experience-heading">Experience</h2>
      <p class="section__intro">
        Shipping product since 2022, most recently customer banking journeys at
        Openbank.
      </p>
      {
        experience.length > 0 && (
          <ol class="roles" id="selected-experience">
            {experience.map(({ data, Content }) => (
              <li class="role" data-role>
                <div class="role__when">
                  <span
                    class:list={[
                      'role__dates',
                      data.isCurrent && 'role__dates--current',
                    ]}
                  >
                    <time datetime={data.startPeriod}>
                      {getYear(data.startPeriod)}
                    </time>
                    {' – '}
                    {data.endPeriod === null ? (
                      'now'
                    ) : (
                      <time datetime={data.endPeriod}>
                        {getYear(data.endPeriod)}
                      </time>
                    )}
                  </span>
                  <span class="role__organisation">{data.organisation}</span>
                  <span class="role__summary">{data.summary}</span>
                </div>
                <div class="role__body">
                  <h3>
                    {data.role}
                    <span class="visually-hidden">at {data.organisation}</span>
                  </h3>
                  <div class="role__content">
                    <Content />
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section id="work" class="section" aria-labelledby="work-heading">
      <span class="node" aria-hidden="true" data-node></span>
      <h2 id="work-heading">Work</h2>
      <p class="section__intro">
        Public projects with their decisions and evidence.
      </p>
      {
        cases.length > 0 && (
          <div class="cases" id="selected-projects">
            {cases.map((project) => (
              <ProjectCase project={project} />
            ))}
          </div>
        )
      }
    </section>

    <section id="about" class="section" aria-labelledby="about-heading">
      <span class="node" aria-hidden="true" data-node></span>
      <h2 id="about-heading">About</h2>
      <div class="about" id="process">
        <p class="about__highlight">
          I care about the behaviour behind the interface as much as the
          interface itself.
        </p>
        <p>
          My strongest professional depth is in frontend engineering: React,
          TypeScript, semantic interfaces, component architecture, complex user
          flows, and maintainable product surfaces.
        </p>
      </div>
    </section>

    <section
      id="contact"
      class="section contact"
      aria-labelledby="contact-heading"
    >
      <span class="node" aria-hidden="true" data-node></span>
      <h2 id="contact-heading">Contact</h2>
      <p class="section__intro">Email is the quickest way to reach me.</p>
      <div class="contact__address">
        <code id="contact-address">{contactEmail}</code>
        <button
          class="button contact__copy"
          id="copy-address"
          type="button"
          hidden
        >
          Copy address
        </button>
        <span class="contact__status" id="copy-status" role="status"></span>
      </div>
      <div class="actions">
        <a class="button" href={linkedInUrl} rel="noreferrer" target="_blank">
          LinkedIn ↗
        </a>
        <a class="button" href={githubUrl} rel="noreferrer" target="_blank">
          GitHub ↗
        </a>
        <a class="button" href={cvAction.href} download>{cvLabel}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initCurrentSection } from '../scripts/current-section';

  initCurrentSection(
    [...document.querySelectorAll<HTMLAnchorElement>('#primary-navigation a')],
    [...document.querySelectorAll<HTMLElement>('.frame > section[id]')],
  );

  const address = document.querySelector<HTMLElement>('#contact-address');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-address');
  const copyStatus = document.querySelector<HTMLElement>('#copy-status');

  if (address && copyButton && copyStatus && navigator.clipboard) {
    let resetTimer: number | undefined;

    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);

      try {
        await navigator.clipboard.writeText(address.textContent?.trim() ?? '');
        copyStatus.textContent = 'Copied';
        resetTimer = window.setTimeout(() => {
          copyStatus.textContent = '';
        }, 2000);
      } catch {
        window.getSelection()?.selectAllChildren(address);
        copyStatus.textContent = 'Address selected, copy it manually';
      }
    });
  }
</script>

<style>
  .frame {
    --trace-gutter: 56px;

    position: relative;
    padding-inline-start: var(--trace-gutter);
    overflow-wrap: break-word;
  }

  .trace {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 11px;
    inline-size: 2px;
    /* motion.css dims the track and fills it with signal while reading. */
    background-color: var(--trace-track, var(--colour-signal));
    opacity: 0.9;
  }

  .node {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-start: calc(-1 * var(--trace-gutter) + 4px);
    box-sizing: border-box;
    inline-size: 16px;
    block-size: 16px;
    border: 2px solid var(--colour-signal);
    border-radius: 50%;
    background-color: var(--colour-surface-page);
  }

  .node::after {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background-color: var(--colour-signal);
    content: '';
  }

  section {
    position: relative;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-5) var(--space-9);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--colour-text-secondary);
    font-family: var(--font-data);
    font-size: 13px;
  }

  .hero__lamp {
    inline-size: 9px;
    block-size: 9px;
    flex: none;
    border-radius: 50%;
    background-color: var(--colour-signal);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--colour-signal) 18%, transparent);
  }

  .hero-name {
    margin: 0;
    font-size: clamp(2.5rem, min(11vw, 16vh), 9.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.86;
  }

  .hero-name span {
    display: block;
  }

  .hero__lede {
    max-inline-size: 34ch;
    margin: 0;
    color: var(--colour-text-primary);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .hero__facts {
    display: grid;
    max-inline-size: 860px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--colour-border-subtle);
    background-color: var(--colour-border-subtle);
  }

  .hero__fact {
    display: grid;
    gap: var(--space-1);
    padding: 18px 20px;
    background-color: var(--colour-surface-page);
  }

  .hero__fact dt {
    color: var(--colour-text-muted);
    font-family: var(--font-data);
    font-size: 13px;
  }

  .hero__fact dd {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    min-block-size: 48px;
    align-items: center;
    padding: 0 22px;
    border: 1px solid var(--colour-text-primary);
    background-color: transparent;
    color: var(--colour-text-primary);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .button:hover {
    border-color: var(--colour-signal);
    color: var(--colour-text-primary);
  }

  .button--primary {
    border-color: var(--colour-signal);
    background-color: var(--colour-signal);
    color: var(--colour-text-on-signal);
  }

  .button--primary:hover {
    border-color: var(--colour-signal-hover);
    background-color: var(--colour-signal-hover);
    color: var(--colour-text-on-signal);
  }

  .button[hidden] {
    display: none;
  }

  /* Sections */
  .section {
    padding-block: 56px 80px;
    border-block-start: 1px solid var(--colour-border-subtle);
  }

  .section > h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .section__intro {
    max-inline-size: 58ch;
    margin: 0 0 40px;
    color: var(--colour-text-secondary);
  }

  /* Experience */
  .roles {
    display: grid;
    gap: 28px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role {
    position: relative;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: var(--space-2) 40px;
    padding: 28px;
    border: 1px solid var(--colour-border-subtle);
    background-color: var(--colour-surface-default);
  }

  .role::before {
    position: absolute;
    inset-block-start: 40px;
    inset-inline-start: calc(-1 * var(--trace-gutter) + 12px);
    inline-size: calc(var(--trace-gutter) - 12px);
    block-size: 1px;
    background-color: var(--colour-border-subtle);
    content: '';
  }

  .role__when {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    color: var(--colour-text-muted);
  }

  .role__dates {
    font-family: var(--font-data);
    font-size: 13px;
  }

  .role__dates--current {
    color: var(--colour-signal);
  }

  .role__organisation {
    color: var(--colour-text-primary);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .role__summary {
    font-size: var(--type-body-small-font-size);
    line-height: var(--type-body-small-line-height);
  }

  .role__body h3 {
    margin: 0 0 var(--space-2);
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .role__content {
    max-inline-size: 64ch;
    color: var(--colour-text-secondary);
  }

  .role__content :global(h4),
  .role__content :global(h5) {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--colour-text-primary);
    font-size: var(--type-body-font-size);
    font-weight: 700;
    line-height: var(--type-body-line-height);
  }

  .role__content :global(h5) {
    margin-block-start: var(--space-4);
    color: var(--colour-text-secondary);
  }

  .role__content :global(h4:first-child) {
    margin-block-start: 0;
  }

  .role__content :global(p) {
    margin: 0;
  }

  .role__content :global(ul) {
    display: grid;
    gap: 6px;
    padding-inline-start: 18px;
    margin: 0;
  }

  /* Work */
  .cases {
    display: grid;
    gap: var(--space-6);
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-6);
  }

  .about p {
    margin: 0;
    color: var(--colour-text-secondary);
  }

  .about .about__highlight {
    color: var(--colour-text-primary);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* Contact */
  .contact .section__intro {
    margin-block-end: var(--space-5);
  }

  .contact__address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
  }

  .contact__address code {
    min-inline-size: 0;
    max-inline-size: 100%;
    padding: 10px 14px;
    border: 1px solid var(--colour-border-subtle);
    background-color: var(--colour-surface-default);
    font-size: 16px;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .contact__copy {
    min-block-size: 44px;
    padding: 0 var(--space-4);
  }

  .contact__status {
    color: var(--colour-signal);
    font-family: var(--font-data);
    font-size: 13px;
  }

  @media (max-width: 719.98px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      padding: 22px;
    }
  }

  @media (max-width: 479.98px) {
    .frame {
      --trace-gutter: 32px;
    }

    .trace {
      inset-inline-start: 7px;
    }

    .node {
      inset-inline-start: calc(-1 * var(--trace-gutter));
    }

    .role {
      padding: var(--space-4);
    }

    .contact__address code {
      font-size: 14px;
    }
  }

  @media (forced-colors: active) {
    .trace,
    .node,
    .node::after,
    .hero__lamp {
      forced-color-adjust: none;
      border-color: CanvasText;
      background-color: CanvasText;
    }

    .node {
      background-color: Canvas;
    }
  }
</style>
