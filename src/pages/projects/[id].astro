---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getProjectById,
  getProjectState,
  getProjects,
} from '../../lib/content/projects';
import type { RootRelativePath } from '../../lib/siteMetadata';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;

if (id === undefined) {
  throw new Error('Project detail route requires a project id.');
}

const projectDocument = await getProjectById(id);

if (projectDocument === undefined) {
  throw new Error(`Project detail route could not find project "${id}".`);
}

const project = projectDocument.data;
const Content = projectDocument.Content;
const pathname = `/projects/${project.id}/` as RootRelativePath;

const state = getProjectState(project);
const projects = await getProjects();
const nextProject = projects.find((candidate) => candidate.id !== project.id);
const sourceUrl = project.publicLinks?.find((link) =>
  /^https:\/\/github\.com\//.test(link),
);
const stack = project.technologies?.join(', ');
const steps = [
  { id: 'problem', label: 'Problem' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'evidence', label: 'Evidence' },
  { id: 'outcome', label: 'Outcome' },
];
---

<BaseLayout
  title={project.title}
  description={project.summary}
  pathname={pathname}
>
  <a class="back-link" href="/#work">Back to work</a>

  <article class="case-page" aria-labelledby="case-title">
    <header class="case-head">
      <span class="read-progress" data-read-progress aria-hidden="true"></span>
      <p class="case-state" data-tone={state.tone}>
        <span aria-hidden="true">{state.symbol}</span>{' '}{state.label}
      </p>
      <h1 id="case-title" data-case-title={project.id}>{project.title}</h1>
      <p class="lede">{project.summary}</p>
      <dl class="facts" data-case-facts>
        <div>
          <dt>role</dt>
          <dd>{project.role}</dd>
        </div>
        {
          stack !== undefined && (
            <div>
              <dt>stack</dt>
              <dd>{stack}</dd>
            </div>
          )
        }
        {
          sourceUrl !== undefined && (
            <div>
              <dt>source</dt>
              <dd>
                <a href={sourceUrl} rel="noreferrer">
                  GitHub repository
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="case-layout">
      <ol class="steps" data-case-steps aria-label="Case sections">
        {
          steps.map((step) => (
            <li>
              <a href={`#${step.id}`}>{step.label}</a>
            </li>
          ))
        }
      </ol>
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      nextProject !== undefined && (
        <nav class="case-next" aria-label="Case navigation">
          <a href={`/projects/${nextProject.id}/`}>
            Next case: {nextProject.title}
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  :global(#main-content) {
    inline-size: min(
      100% - (2 * var(--layout-gutter-mobile)),
      var(--layout-content-standard)
    );
  }

  .back-link,
  .case-next a {
    display: inline-flex;
    min-block-size: 44px;
    align-items: center;
    color: var(--colour-text-primary);
    font-family: var(--font-data);
    font-size: 0.875rem;
  }

  .back-link:hover,
  .case-next a:hover {
    color: var(--colour-signal-hover);
  }

  .case-page {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .case-head {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-7);
  }

  .read-progress {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    block-size: 0;
  }

  .case-state {
    margin: 0;
    color: var(--colour-text-muted);
    font-family: var(--font-data);
    font-size: 0.875rem;
  }

  .case-state[data-tone='signal'] {
    color: var(--colour-signal);
  }

  .case-state[data-tone='caution'] {
    color: var(--colour-caution);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lede {
    max-inline-size: 46ch;
    margin: 0;
    color: var(--colour-text-secondary);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.4;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--colour-border-subtle);
    background-color: var(--colour-border-subtle);
  }

  .facts div {
    padding: var(--space-4);
    background-color: var(--colour-surface-page);
  }

  .facts dt {
    color: var(--colour-text-muted);
    font-family: var(--font-data);
    font-size: 0.8125rem;
  }

  .facts dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }

  .facts a {
    color: var(--colour-text-primary);
  }

  .case-layout {
    display: grid;
    gap: var(--space-5);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--colour-border-subtle);
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
    font-family: var(--font-data);
    font-size: 0.875rem;
    list-style: none;
  }

  .steps a {
    display: inline-flex;
    min-block-size: 44px;
    align-items: center;
    color: var(--colour-text-secondary);
    text-decoration: none;
  }

  .steps a:hover {
    color: var(--colour-signal-hover);
  }

  .prose {
    min-inline-size: 0;
    color: var(--colour-text-secondary);
  }

  .prose :global(h2) {
    margin: 0 0 var(--space-4);
    color: var(--colour-text-primary);
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    scroll-margin-block-start: var(--space-8);
  }

  .prose :global(h2:not(:first-child)) {
    margin-block-start: var(--space-8);
  }

  .prose :global(p) {
    max-inline-size: 64ch;
    margin: 0 0 var(--space-3);
  }

  .prose :global(.decision) {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    margin-block-end: var(--space-4);
    border: 1px solid var(--colour-border-subtle);
    background-color: var(--colour-surface-default);
  }

  .prose :global(.decision h3) {
    margin: 0;
    color: var(--colour-text-primary);
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .prose :global(.decision p) {
    margin: 0;
  }

  .prose :global(.decision p:first-child) {
    color: var(--colour-text-muted);
    font-family: var(--font-data);
    font-size: 0.8125rem;
  }

  .prose :global(.decision p:last-child) {
    color: var(--colour-text-muted);
  }

  .prose :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--colour-border-subtle);
    text-align: start;
  }

  .case-next {
    display: flex;
    flex-wrap: wrap;
    padding-block: var(--space-6) var(--space-8);
    margin-block-start: var(--space-6);
    border-block-start: 1px solid var(--colour-border-subtle);
  }

  @media (min-width: 48rem) {
    :global(#main-content) {
      inline-size: min(
        100% - (2 * var(--layout-gutter-tablet)),
        var(--layout-content-standard)
      );
    }
  }

  @media (min-width: 51.25rem) {
    .case-layout {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-8);
      padding-block-start: var(--space-7);
    }

    .steps {
      position: sticky;
      inset-block-start: 96px;
      align-self: start;
      display: grid;
      gap: var(--space-1);
      padding-inline-start: var(--space-4);
      border-inline-start: 2px solid var(--colour-border-subtle);
    }
  }

  @media (min-width: 70rem) {
    :global(#main-content) {
      inline-size: min(
        100% - (2 * var(--layout-gutter-desktop)),
        var(--layout-content-standard)
      );
    }
  }
</style>
